---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { langPaths } from "../../i18n";
import { url, DEFAULT_LANG, type Lang } from "../../config";
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
// /en/ is kept only so old links still work: it forwards to the root.
const home = url("/");
---
{lang === DEFAULT_LANG ? (
  <html lang="en"><head>
    <meta charset="utf-8"><title>Igor Lopes</title>
    <meta http-equiv="refresh" content={`0; url=${home}`}>
    <link rel="canonical" href={new URL(home, Astro.site).href}>
    <meta name="robots" content="noindex">
  </head><body><a href={home}>Igor Lopes</a></body></html>
) : (
  <Base lang={lang} path="/" image="star/loop-poster.webp">
    <Home lang={lang} />
  </Base>
)}
