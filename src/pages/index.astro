---
// The root is the English home. A French or Dutch browser that has never picked a language is sent to /fr/ or /nl/.
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { url } from "../config";
---
<Base lang="en" path="/" image="star/loop-poster.webp">
<script slot="head" is:inline define:vars={{ base: url("/") }}>
  try {
    if (!localStorage.getItem("lang")) {
      var l = (navigator.languages && navigator.languages[0] || navigator.language || "en").slice(0, 2).toLowerCase();
      if (l === "fr" || l === "nl") location.replace(base + l + "/");
    }
  } catch (e) {}
</script>
  <Home lang="en" />
</Base>
