---
import Pic from "./Pic.astro";
import { lab } from "../data/projects";
import { SITE, url, type Lang } from "../config";
import { t, tx } from "../i18n";
interface Props { lang: Lang; heading?: "h1" | "h2"; lead?: boolean }
const { lang, heading = "h2", lead = true } = Astro.props;
const H = heading;
---
<section class="lab" data-theme="dark" data-lamp id="lab" aria-labelledby="lab-title">
  <div class="lab__head">
    <H id="lab-title">{t(lang, "lab.title")}</H>
    {lead && <p>{t(lang, "lab.lead")}</p>}
  </div>
  <ul class="lab__grid">
    {lab.map((p) => {
      const inner = (
        <>
          {p.cover && (
            <span class:list={["lab__frame", { "lab__frame--whole": p.coverBg }]} style={p.coverBg ? `background:${p.coverBg}` : undefined}>
              <Pic src={p.cover.src} alt={tx(p.cover.alt, lang)} sizes="(max-width: 599px) 100vw, (max-width: 899px) 50vw, 33vw" />
            </span>
          )}
          <span class="lab__name">{p.name}</span>
          <span class="lab__what">{tx(p.where, lang)}</span>
          <span class="lab__kind">{p.context && <>{t(lang, `context.${p.context}`)} &middot; </>}{tx(p.roles, lang)}{p.link && <> &middot; {t(lang, p.link.label === "watch" ? "lab.watch" : "lab.visit")}</>}</span>
        </>
      );
      return (
        <li class="lab__item" data-reveal>
          {p.link ? <a href={p.link.href} target="_blank" rel="noopener" data-cursor={t(lang, p.link.label === "watch" ? "lab.watch" : "lab.visit")}>{inner}</a>
            : p.blocks ? <a href={url(`/${lang}/work/${p.slug}/`)} data-cursor={`${t(lang, "work.open")} ${p.name}`}>{inner}</a>
            : <div>{inner}</div>}
        </li>
      );
    })}
  </ul>
  <p class="lab__more"><a href={SITE.youtube} target="_blank" rel="noopener" data-widen="self" data-cursor="YouTube">{t(lang, "lab.channel")} &rarr;</a></p>
</section>
